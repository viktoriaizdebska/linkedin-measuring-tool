# Set these as Railway variables (never commit real values).
DATABASE_URL=            # Railway: ${{Postgres.DATABASE_URL}}
APP_PASSWORD=            # optional: one password the browser asks for; empty = open site
CRON_SECRET=             # secret for the daily job endpoint
APP_URL=                 # the public address, used in emails
SEED_ON_EMPTY=false      # true only for a staging database
